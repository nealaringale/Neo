NEO_NAME=Neo
NEO_USER_NAME=Neal
NEO_LOG_LEVEL=INFO

# Optional local LLM
NEO_LLM_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Voice
PICOVOICE_ACCESS_KEY=
NEO_WAKE_WORD_PATH=models/neo_windows.ppn
NEO_VOSK_MODEL_PATH=models/vosk-model-small-en-in-0.4
NEO_AUDIO_DEVICE=-1
NEO_WAKE_SENSITIVITY=0.55
NEO_COMMAND_MAX_SECONDS=8
NEO_TTS_VOICE=
NEO_TTS_RATE=175
NEO_TTS_VOLUME=1.0
